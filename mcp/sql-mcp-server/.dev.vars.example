# Local settings for `npm run dev` (wrangler dev). Copy to .dev.vars, which is gitignored,
# and fill the blanks. Every variable is described in docs/system-spec/environments.md.

# Deployment secret every key derives from: 32 random bytes, base64url.
#   openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SERVER_SECRET=
# Set only while rotating SERVER_SECRET (docs/system-spec/security.md).
SERVER_SECRET_PREVIOUS=

# Identity provider. Sign-in stays off, and every MCP call gets 401, until all three are set.
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0   Google: https://accounts.google.com
IDP_ISSUER=
IDP_CLIENT_ID=
IDP_CLIENT_SECRET=
# Optional. Default: openid profile email offline_access (Google: openid profile email).
IDP_SCOPES=

# Optional. The external origin, when a proxy sits in front; wrangler dev uses the request's origin.
PUBLIC_URL=

# Not here, on purpose: ENGINE (a var in wrangler.jsonc), HYPERDRIVE (a binding in wrangler.jsonc,
# whose localConnectionString points wrangler dev at the Docker PostgreSQL), and DATABASE_URL and
# PORT (used by the Azure container only).

# Server settings later slices read (environments.md).
PERMISSION_TIER=read-only
ROW_LIMIT=500
REDACTION=on
BOUNDARY=
