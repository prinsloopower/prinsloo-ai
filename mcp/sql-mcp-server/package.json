{
  "name": "sql-mcp-server",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:one": "vitest run -t",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose -f test/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f test/docker-compose.yml down",
    "db:mssql:certs": "node scripts/mssql-certs.mjs",
    "db:mssql:seed": "tsx test/mssql/seed.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "tsx deploy/cloudflare/setup.ts",
    "export": "tsx release/export.ts",
    "smoke": "node scripts/smoke.mjs",
    "benchmark": "tsx bench/run.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@libpg-query/parser": "^17.8.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tediousjs/connection-string": "^1.1.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mssql": "^12.7.14",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261006.1": true
  }
}
