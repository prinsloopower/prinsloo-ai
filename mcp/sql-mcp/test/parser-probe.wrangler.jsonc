// Test-only config for test/parser-probe.worker.ts, run in local workerd by test/query/parser.test.ts.
// Same runtime settings as wrangler.jsonc, with no bindings.
{
  "name": "sql-mcp-server-parser-probe",
  "main": "parser-probe.worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // As in wrangler.jsonc: the parser's Emscripten glue reads these, which Workers do not define.
  "define": { "__filename": "\"/libpg-query.js\"", "__dirname": "\"/\"" }
}
